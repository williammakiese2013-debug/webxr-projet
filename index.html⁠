/* ============================================================
   STEREO GAME CANVAS
   On dessine tout en double côte à côte sur un seul canvas
============================================================ */
function startGame(type) {
  hide('launcher'); show('stereo-game'); showBack(); showLensControls();
  const canvas = document.getElementById('game-canvas');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  if (type === 'shooter') runShooterStereo(canvas);
  else if (type === 'dodge') runDodgeStereo(canvas);
}

/* ── dessin stéréo helper ──
   fn(ctx, ox, W, H) dessine UNE vue dans la moitié gauche (ox=0) ou droite (ox=halfW)
*/
function drawStereo(ctx, fullW, fullH, fn) {
  const half = fullW / 2;
  // œil gauche
  ctx.save(); ctx.beginPath(); ctx.rect(0, 0, half, fullH); ctx.clip(); fn(ctx, 0, half, fullH); ctx.restore();
  // œil droit
  ctx.save(); ctx.beginPath(); ctx.rect(half, 0, half, fullH); ctx.clip(); fn(ctx, half, half, fullH); ctx.restore();
  // divider
  ctx.fillStyle = '#000';
  ctx.fillRect(half - 1, 0, 3, fullH);
}

/* ── SHOOTER STEREO + GYRO ── */
function runShooterStereo(canvas) {
  if (gameLoop) cancelAnimationFrame(gameLoop);
  const ctx = canvas.getContext('2d');
  const FW = canvas.width, FH = canvas.height;
  const HW = FW / 2;
  let score = 0, targets = [], lives = 3;

  // Chaque cible a un angle 3D (yawDeg, pitchDeg) dans l'espace autour du joueur
  function spawnTarget() {
    targets.push({
      yawDeg:   Math.random() * 360,           // position angulaire horizontale
      pitchDeg: (Math.random() - 0.5) * 60,    // position angulaire verticale (-30..30°)
      r: 22 + Math.random() * 20,
      color: `hsl(${Math.random()*360},70%,55%)`,
      born: Date.now(), ttl: 2800 + Math.random() * 1500
    });
  }

  // Convertit un angle de scène (yaw/pitch) en position écran pour UN œil (ox = offset X)
  function project(targetYaw, targetPitch, cameraYaw, cameraPitch, ox, W, H) {
    const FOV_H = 80; // champ de vision horizontal en degrés
    const FOV_V = 60;
    let dYaw = targetYaw - cameraYaw;
    // normalise entre -180 et 180
    if (dYaw > 180) dYaw -= 360;
    if (dYaw < -180) dYaw += 360;
    const dPitch = targetPitch - cameraPitch;
    // en dehors du FOV → null
    if (Math.abs(dYaw) > FOV_H/2 || Math.abs(dPitch) > FOV_V/2) return null;
    const sx = ox + W/2 + (dYaw / (FOV_H/2)) * (W/2);
    const sy = H/2  - (dPitch / (FOV_V/2)) * (H/2);
    return { x: sx, y: sy };
  }

  // Click/touch → vise avec le gyroscope (centre de l'écran = direction du regard)
  function onShoot() {
    const camYaw   = gyro.yaw;
    const camPitch = -gyro.pitch * 0.5;
    targets = targets.filter(t => {
      const pos = project(t.yawDeg, t.pitchDeg, camYaw, camPitch, 0, HW, FH);
      if (!pos) return true;
      const dx = pos.x - HW/2, dy = pos.y - FH/2;
      if (Math.hypot(dx, dy) < t.r + 20) { score++; return false; }
      return true;
    });
  }
  canvas.addEventListener('click', onShoot);
  canvas.addEventListener('touchstart', e => { e.preventDefault(); onShoot(); }, {passive:false});

  let lastSpawn = 0;
  function draw(ts) {
    if (ts - lastSpawn > 900) { spawnTarget(); lastSpawn = ts; }
    targets = targets.filter(t => {
      if (Date.now() - t.born > t.ttl) { lives--; return false; }
      return true;
    });

    const camYaw   = gyro.yaw;
    const camPitch = -gyro.pitch * 0.5;

    drawStereo(ctx, FW, FH, (c, ox, W, H) => {
      // Fond étoilé qui tourne avec la caméra
      c.fillStyle = '#0a0a1a'; c.fillRect(ox, 0, W, H);
      c.fillStyle = 'rgba(255,255,255,0.35)';
      for (let i = 0; i < 80; i++) {
        // étoile à position angulaire fixe
        const starYaw = (i * 137.508) % 360;
        const starPitch = ((i * 97.3) % 60) - 30;
        const sp = project(starYaw, starPitch, camYaw, camPitch, ox, W, H);
        if (sp) c.fillRect(sp.x, sp.y, 1.5, 1.5);
      }
      // Cibles
      targets.forEach(t => {
        const pos = project(t.yawDeg, t.pitchDeg, camYaw, camPitch, ox, W, H);
        if (!pos) return;
        const age = Date.now() - t.born;
        const ratio = 1 - age / t.ttl;
        c.save(); c.globalAlpha = Math.max(0.15, ratio);
        c.beginPath(); c.arc(pos.x, pos.y, t.r, 0, Math.PI*2);
        c.fillStyle = t.color; c.fill();
        c.beginPath(); c.arc(pos.x, pos.y, t.r*(1-ratio*0.4), 0, Math.PI*2);
        c.strokeStyle='#fff'; c.lineWidth=2; c.stroke();
        // barre de vie (temps restant)
        c.fillStyle='rgba(255,255,255,0.4)';
        c.fillRect(pos.x - t.r, pos.y + t.r + 4, t.r*2*ratio, 3);
        c.restore();
      });
      // Viseur central (suit le regard)
      const cx = ox + W/2, cy = H/2;
      c.strokeStyle='rgba(255,255,255,0.7)'; c.lineWidth=1.5;
      c.beginPath(); c.moveTo(cx-14,cy); c.lineTo(cx+14,cy); c.stroke();
      c.beginPath(); c.moveTo(cx,cy-14); c.lineTo(cx,cy+14); c.stroke();
      c.beginPath(); c.arc(cx,cy,7,0,Math.PI*2); c.stroke();
      // HUD
      c.fillStyle='#fff'; c.font=`bold ${Math.floor(W*0.06)}px Segoe UI`;
      c.fillText(`${score}`, ox+16, 42);
      c.fillStyle='#e53e3e'; c.fillText(`❤${lives}`, ox+W-70, 42);
      // boussole gyro
      c.fillStyle='rgba(127,90,240,0.5)'; c.font=`${Math.floor(W*0.035)}px Segoe UI`;
      c.fillText(`${Math.round(camYaw)}°`, ox + W/2 - 15, H - 12);
    });

    if (lives <= 0) {
      ctx.fillStyle='rgba(0,0,0,0.85)'; ctx.fillRect(0,0,FW,FH);
      ctx.fillStyle='#fff'; ctx.textAlign='center';
      ctx.font=`bold ${Math.floor(FW*0.05)}px Segoe UI`;
      ctx.fillText('Game Over!', FW/2, FH/2-20);
      ctx.font=`${Math.floor(FW*0.03)}px Segoe UI`;
      ctx.fillText(`Score: ${score}   Touche pour rejouer`, FW/2, FH/2+40);
      canvas.onclick = canvas.ontouchstart = () => {
        score=0; lives=3; targets=[];
        canvas.onclick=canvas.ontouchstart=null;
        runShooterStereo(canvas);
      };
      return;
    }
    gameLoop = requestAnimationFrame(draw);
  }
  gameLoop = requestAnimationFrame(draw);
}

/* ── DODGE STEREO + GYRO ── */
function runDodgeStereo(canvas) {
  if (gameLoop) cancelAnimationFrame(gameLoop);
  const ctx = canvas.getContext('2d');
  const FW = canvas.width, FH = canvas.height;
  const HW = FW / 2;
  let px = HW/2, py = FH*0.75, pr = 20;
  let obstacles = [], score = 0, speed = 3, alive = true, frame = 0;

  // Touch fallback
  canvas.addEventListener('touchmove', e => {
    e.preventDefault();
    const t = e.touches[0];
    const rect = canvas.getBoundingClientRect();
    let mx = (t.clientX - rect.left) * (FW/rect.width);
    if (mx > HW) mx -= HW;
    px = mx;
  }, {passive:false});

  function spawnObs() {
    obstacles.push({
      x: Math.random()*(HW-60)+30, y: -30,
      w: 28+Math.random()*50, h: 18+Math.random()*20,
      color: `hsl(${Math.random()*60},80%,55%)`
    });
  }

  let lastObs = 0;
  function draw(ts) {
    frame++;
    if (ts - lastObs > Math.max(380, 900-score*2)) { spawnObs(); lastObs=ts; }
    speed = 3 + score*0.04;

    // Gyro roll → déplace le joueur gauche/droite
    // En mode paysage, gamma = inclinaison haut/bas du téléphone (roll devient beta)
    const tilt = gyro.active ? gyro.roll / 45 : 0; // -1 à 1
    px = Math.max(pr, Math.min(HW-pr, px + tilt * 8));

    // Gyro yaw → décale le fond étoilé (sensation de regarder autour)
    const bgOffset = (gyro.yaw / 360) * HW;

    obstacles.forEach(o => { o.y += speed; });
    obstacles = obstacles.filter(o => {
      if (Math.abs(o.x-px)<(o.w/2+pr-8) && Math.abs(o.y-py)<(o.h/2+pr-8)) alive=false;
      return o.y < FH+40;
    });
    score++;

    drawStereo(ctx, FW, FH, (c, ox, W, H) => {
      c.fillStyle='#0a0a1a'; c.fillRect(ox,0,W,H);
      // Fond étoilé défilant + panoramique gyro
      c.fillStyle='rgba(255,255,255,0.28)';
      for(let i=0;i<60;i++){
        const sy=((i*89.3*7 + frame*(0.3+i*0.01)) % H);
        const sx = ox + ((i*137.5 + bgOffset) % W);
        c.fillRect(sx, sy, 2, 2);
      }
      // Obstacles
      obstacles.forEach(o=>{
        c.fillStyle=o.color;
        c.beginPath(); c.roundRect(ox+o.x-o.w/2, o.y-o.h/2, o.w, o.h, 6); c.fill();
      });
      // Player
      c.beginPath(); c.arc(ox+px, py, pr, 0, Math.PI*2);
      const g=c.createRadialGradient(ox+px,py,0,ox+px,py,pr);
      g.addColorStop(0,'#2cb67d'); g.addColorStop(1,'#7f5af0');
      c.fillStyle=g; c.fill();
      // Indicateur de tilt
      c.fillStyle='rgba(255,255,255,0.2)';
      c.fillRect(ox + W/2 - 40, H - 10, 80, 4);
      c.fillStyle='#7f5af0';
      c.fillRect(ox + W/2 + tilt*38, H - 12, 6, 8);
      // HUD
      c.fillStyle='#fff'; c.font=`bold ${Math.floor(W*0.06)}px Segoe UI`;
      c.fillText(`${Math.floor(score/10)}`, ox+14, 42);
    });

    if(!alive){
      ctx.fillStyle='rgba(0,0,0,0.85)'; ctx.fillRect(0,0,FW,FH);
      ctx.fillStyle='#fff'; ctx.textAlign='center';
      ctx.font=`bold ${Math.floor(FW*0.05)}px Segoe UI`;
      ctx.fillText('💥 Touché!', FW/2, FH/2-20);
      ctx.font=`${Math.floor(FW*0.03)}px Segoe UI`;
      ctx.fillText(`Score: ${Math.floor(score/10)}   Touche pour rejouer`, FW/2, FH/2+40);
      canvas.ontouchstart=canvas.onclick=()=>{
        alive=true; obstacles=[]; score=0; px=HW/2; frame=0;
        canvas.onclick=canvas.ontouchstart=null;
        runDodgeStereo(canvas);
      };
      return;
    }
    gameLoop=requestAnimationFrame(draw);
  }
  gameLoop=requestAnimationFrame(draw);
}

