// Forcer le plein écran + paysage + permission gyro au premier clic/toucher
function activerPleinEcran() {
  const docEl = document.documentElement;
  if (docEl.requestFullscreen) {
    docEl.requestFullscreen();
  } else if (docEl.webkitRequestFullscreen) {
    docEl.webkitRequestFullscreen();
  }
  if (screen.orientation && screen.orientation.lock) {
    screen.orientation.lock('landscape').catch(() => {});
  }
  // Demande permission gyro iOS 13+ dès le premier geste utilisateur
  if (typeof DeviceOrientationEvent !== 'undefined' &&
      typeof DeviceOrientationEvent.requestPermission === 'function') {
    DeviceOrientationEvent.requestPermission().catch(() => {});
  }
}
window.addEventListener('click', activerPleinEcran, { once: true });
window.addEventListener('touchstart', activerPleinEcran, { once: true });

/* ============================================================
   BARREL DISTORTION — WebGL post-processing overlay
   Capture l'écran via html2canvas puis applique un shader
   de distorsion en barillet sur chaque demi-écran (œil)
============================================================ */
let barrelEnabled = false;
let barrelK = 0.30; // coefficient de distorsion (0 = aucune, 1 = max)
let barrelGL = null;
let barrelProgram = null;
let barrelTex = null;
let barrelLoop = null;

const VERT_SRC = `
  attribute vec2 a_pos;
  varying vec2 v_uv;
  void main() {
    v_uv = a_pos * 0.5 + 0.5;
    gl_Position = vec4(a_pos, 0.0, 1.0);
  }
`;

// Barrel distortion per-eye:
// chaque moitié de l'écran est traitée indépendamment
const FRAG_SRC = `
  precision mediump float;
  uniform sampler2D u_tex;
  uniform float u_k;       // barrel coeff
  varying vec2 v_uv;

  vec2 barrel(vec2 uv, vec2 center, float k) {
    vec2 d = uv - center;
    float r2 = dot(d, d);
    return center + d * (1.0 + k * r2 + k * k * r2 * r2);
  }

  void main() {
    float isRight = step(0.5, v_uv.x);
    // centre de chaque œil dans l'espace UV
    vec2 center = vec2(isRight * 0.5 + 0.25, 0.5);
    // UV local à l'œil (0..0.5 x 0..1) -> normalisé (-1..1)
    vec2 uv = barrel(v_uv, center, u_k * 0.4);
    // bounds check: noir hors de l'œil
    float lx = isRight * 0.5;
    if (uv.x < lx || uv.x > lx + 0.5 || uv.y < 0.0 || uv.y > 1.0) {
      gl_FragColor = vec4(0.0, 0.0, 0.0, 1.0);
    } else {
      gl_FragColor = texture2D(u_tex, uv);
    }
  }
`;

function initBarrelGL() {
  const canvas = document.getElementById('barrel-canvas');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;

  const gl = canvas.getContext('webgl', {preserveDrawingBuffer: false, alpha: false});
  if (!gl) return false;
  barrelGL = gl;

  // Shaders
  function compile(type, src) {
    const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s); return s;
  }
  const prog = gl.createProgram();
  gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT_SRC));
  gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG_SRC));
  gl.linkProgram(prog);
  barrelProgram = prog;

  // Full-screen quad
  const buf = gl.createBuffer();
  gl.bindBuffer(gl.ARRAY_BUFFER, buf);
  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 1,-1, -1,1, 1,1]), gl.STATIC_DRAW);
  const loc = gl.getAttribLocation(prog, 'a_pos');
  gl.enableVertexAttribArray(loc);
  gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

  // Texture
  barrelTex = gl.createTexture();
  gl.bindTexture(gl.TEXTURE_2D, barrelTex);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);

  return true;
}

function barrelFrame() {
  if (!barrelEnabled || !barrelGL) return;
  const gl = barrelGL;
  const W = window.innerWidth, H = window.innerHeight;

  // Capture the page behind the canvas via screenshot of the body
  // We use a hidden canvas + drawWindow (only in Firefox) OR
  // capture the game canvas directly if in game mode
  let srcCanvas = null;
  if (document.getElementById('stereo-game').classList.contains('active')) {
    srcCanvas = document.getElementById('game-canvas');
  }
  // For other modes we skip (WebGL scenes handle their own stereo)
  if (!srcCanvas) { barrelLoop = requestAnimationFrame(barrelFrame); return; }

  gl.canvas.width = W; gl.canvas.height = H;
  gl.viewport(0, 0, W, H);
  gl.useProgram(barrelProgram);

  // Upload game canvas as texture
  gl.bindTexture(gl.TEXTURE_2D, barrelTex);
  gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, srcCanvas);

  gl.uniform1i(gl.getUniformLocation(barrelProgram, 'u_tex'), 0);
  gl.uniform1f(gl.getUniformLocation(barrelProgram, 'u_k'), barrelK);

  gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
  barrelLoop = requestAnimationFrame(barrelFrame);
}

function enableBarrel() {
  if (!barrelGL && !initBarrelGL()) return;
  document.getElementById('barrel-canvas').classList.add('active');
  barrelEnabled = true;
  if (barrelLoop) cancelAnimationFrame(barrelLoop);
  barrelFrame();
}

function disableBarrel() {
  barrelEnabled = false;
  if (barrelLoop) { cancelAnimationFrame(barrelLoop); barrelLoop = null; }
  document.getElementById('barrel-canvas').classList.remove('active');
}

function toggleLens() {
  barrelEnabled = !barrelEnabled;
  const btn = document.getElementById('lens-toggle');
  if (barrelEnabled) { enableBarrel(); btn.textContent = 'ON'; btn.classList.remove('off'); }
  else { disableBarrel(); btn.textContent = 'OFF'; btn.classList.add('off'); }
}

function updateLens(val) {
  barrelK = val / 100;
  document.getElementById('lens-val').textContent = barrelK.toFixed(2);
}

function showLensControls() {
  document.getElementById('lens-controls').classList.add('show');
}
function hideLensControls() {
  document.getElementById('lens-controls').classList.remove('show');
  disableBarrel();
  const btn = document.getElementById('lens-toggle');
  btn.textContent = 'ON'; btn.classList.remove('off');
  barrelEnabled = false;
}

window.addEventListener('resize', ()=>{
  const c=document.getElementById('game-canvas');
  if(c){ c.width=window.innerWidth; c.height=window.innerHeight; }
  const vc=document.getElementById('vr-canvas');
  if(vc){ vc.width=window.innerWidth; vc.height=window.innerHeight; }
});

