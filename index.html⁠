<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>VR Cardboard Hub</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/aframe/1.5.0/aframe.min.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #0a0a1a; color: #fff; font-family: 'Segoe UI', sans-serif; overflow: hidden; width: 100vw; height: 100vh; }

    /* ── LAUNCHER VR (photo 360° réelle en fond, menu ancré dans l'espace) ── */
    #launcher {
      position: fixed; inset: 0; z-index: 100;
      background: #05051a;
    }
    #launcher-scene { width: 100%; height: 100%; }
    #launcher-loading {
      position: absolute; inset: 0; z-index: 5;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 10px; background: #05050f; pointer-events: none;
      transition: opacity .4s ease;
    }
    #launcher-loading.hidden { opacity: 0; visibility: hidden; }
    #launcher-loading .spin {
      width: 34px; height: 34px; border-radius: 50%;
      border: 3px solid rgba(127,90,240,0.25); border-top-color: #7f5af0;
      animation: spin 0.9s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    #launcher-loading p { font-size: 0.75rem; color: #72757e; }
    @keyframes shimmer { 0%{background-position:0%} 100%{background-position:200%} }

    /* ── BACK BUTTON ── */
    #back-btn {
      position: fixed; top: 12px; left: 50%; transform: translateX(-50%); z-index: 500;
      background: rgba(0,0,0,0.75); border: 1px solid rgba(255,255,255,0.2);
      color: #fff; border-radius: 50px; padding: 8px 22px;
      font-size: 0.8rem; cursor: pointer; display: none; backdrop-filter: blur(8px); white-space: nowrap;
    }
    #back-btn.show { display: block; }

    /* ── STEREO WRAPPER ── */
    /* Used for GAMES and BROWSER in stereo mode */
    #stereo-wrap {
      position: fixed; inset: 0; display: none; z-index: 200;
      flex-direction: row;
    }
    #stereo-wrap.active { display: flex; }
    /* Left eye */
    #eye-left, #eye-right {
      flex: 1; overflow: hidden; position: relative;
    }
    /* Center divider line */
    #stereo-wrap::after {
      content: ''; position: absolute; left: 50%; top: 0; width: 3px; height: 100%;
      background: #000; z-index: 10;
      transform: translateX(-50%);
    }
    /* Each eye clips its canvas/iframe */
    #eye-left canvas, #eye-right canvas { position: absolute; top: 0; left: 0; }
    /* Left eye: show left half of a double-wide canvas */
    /* We draw everything twice on a single canvas then clip via CSS */

    /* Stereo canvas approach: one big canvas, clipped per eye */
    #stereo-canvas {
      position: fixed; top: 0; left: 0;
      width: 200vw; height: 100vh; display: none; z-index: 150;
      pointer-events: none;
    }
    #stereo-canvas.active { display: block; }

    /* ── VR A-FRAME container ── */
    #vr-container { position: fixed; inset: 0; display: none; z-index: 10; background: #000; }
    #vr-container.active { display: block; }
    #vr-container canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: block; }
    #vr-container::after {
      content: ''; position: absolute; left: 50%; top: 0;
      width: 3px; height: 100%; background: #000; z-index: 20; pointer-events: none;
    }

    /* ── STEREO BROWSER ── */
    #stereo-browser {
      position: fixed; inset: 0; display: none; z-index: 300; flex-direction: column;
    }
    #stereo-browser.active { display: flex; }
    #browser-bar {
      background: #111; padding: 8px 10px; display: flex; gap: 7px; align-items: center;
      z-index: 310; flex-shrink: 0;
    }
    #browser-bar input {
      flex: 1; background: #222; border: 1px solid #333; border-radius: 8px;
      color: #fff; padding: 7px 10px; font-size: 0.85rem; outline: none;
    }
    #browser-bar button { background: #7f5af0; color: #fff; border: none; border-radius: 8px; padding: 7px 12px; cursor: pointer; font-size: 0.8rem; }
    #browser-bar .close-btn { background: #e53e3e; }
    .browser-eyes {
      flex: 1; display: flex; position: relative;
    }
    .browser-eyes::after {
      content: ''; position: absolute; left: 50%; top: 0; width: 3px; height: 100%;
      background: #000; z-index: 10; transform: translateX(-50%);
    }
    .browser-eyes iframe {
      flex: 1; border: none; pointer-events: auto;
    }

    /* ── STEREO GAME ── */
    #stereo-game {
      position: fixed; inset: 0; display: none; z-index: 300; background: #0a0a1a;
    }
    #stereo-game.active { display: block; }
    #stereo-game canvas {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    }
    /* Center divider for game */
    #stereo-game::after {
      content: ''; position: absolute; left: 50%; top: 0;
      width: 3px; height: 100%; background: #000; z-index: 20;
    }

    /* ── BARREL DISTORTION OVERLAY ── */
    #barrel-canvas {
      position: fixed; inset: 0; z-index: 900;
      pointer-events: none; display: none;
      width: 100%; height: 100%;
    }
    #barrel-canvas.active { display: block; }

    /* ── LENS CONTROLS ── */
    #lens-controls {
      position: fixed; bottom: 14px; left: 50%; transform: translateX(-50%);
      z-index: 1000; display: none; gap: 10px; align-items: center;
      background: rgba(0,0,0,0.75); border: 1px solid rgba(255,255,255,0.15);
      border-radius: 50px; padding: 6px 16px; backdrop-filter: blur(8px);
    }
    #lens-controls.show { display: flex; }
    #lens-controls label { font-size: 0.65rem; color: #a0a0b0; white-space: nowrap; }
    #lens-slider { width: 100px; accent-color: #7f5af0; cursor: pointer; }
    #lens-val { font-size: 0.65rem; color: #7f5af0; min-width: 30px; text-align: center; }
    #lens-toggle {
      font-size: 0.65rem; background: #7f5af0; color: #fff; border: none;
      border-radius: 50px; padding: 4px 10px; cursor: pointer; white-space: nowrap;
    }
    #lens-toggle.off { background: #444; }
  </style>
</head>
<body>

<!-- LAUNCHER VR (photo 360° réelle du salon en fond, menu ancré dans l'espace) -->
<div id="launcher">
  <div id="launcher-loading">
    <div class="spin"></div>
    <p>Chargement du salon 360°…</p>
  </div>
  <div id="launcher-scene"></div>
</div>


<!-- BACK BUTTON -->
<button id="back-btn" onclick="goHome()">← Retour</button>

<!-- VR SCENE CANVAS (Espace / Océan / Ville) -->
<div id="vr-container"></div>

<!-- STEREO BROWSER -->
<div id="stereo-browser">
  <div id="browser-bar">
    <button class="close-btn" onclick="goHome()">✕</button>
    <input id="url-input" type="url" placeholder="https://..." value="https://www.wikipedia.org"/>
    <button onclick="navigateTo()">Aller</button>
  </div>
  <div class="browser-eyes">
    <iframe id="iframe-left" src="https://www.wikipedia.org" sandbox="allow-scripts allow-same-origin allow-forms allow-popups"></iframe>
    <iframe id="iframe-right" src="https://www.wikipedia.org" sandbox="allow-scripts allow-same-origin allow-forms allow-popups"></iframe>
  </div>
</div>

<!-- STEREO GAME CANVAS -->
<div id="stereo-game">
  <canvas id="game-canvas"></canvas>
</div>

<!-- BARREL DISTORTION OVERLAY (WebGL) -->
<canvas id="barrel-canvas"></canvas>

<!-- LENS STRENGTH CONTROLS -->
<div id="lens-controls">
  <label>🔭 Lentille</label>
  <input id="lens-slider" type="range" min="0" max="100" value="30" oninput="updateLens(this.value)">
  <span id="lens-val">0.30</span>
  <button id="lens-toggle" onclick="toggleLens()">ON</button>
</div>

<script>
/* ============================================================
   GYROSCOPE GLOBAL — partagé par tous les modes
============================================================ */
const gyro = { alpha: 0, beta: 0, gamma: 0, yaw: 0, pitch: 0, roll: 0, active: false };
let gyroBaseAlpha = null; // calibration

function startGyro() {
  gyro.active = false;
  gyroBaseAlpha = null;

  function onOrientation(e) {
    if (!gyro.active) { gyro.active = true; }
    // Sur iOS en mode paysage, on remmappe les axes
    const a = e.alpha || 0;  // rotation autour Z (yaw boussole 0-360)
    const b = e.beta  || 0;  // inclinaison avant/arrière (-180..180)
    const g = e.gamma || 0;  // inclinaison gauche/droite (-90..90)

    // Calibration : fixer le point de départ à 0
    if (gyroBaseAlpha === null) gyroBaseAlpha = a;

    gyro.yaw   = ((a - gyroBaseAlpha + 360) % 360); // 0-360°
    gyro.pitch = b;   // haut/bas
    gyro.roll  = g;   // gauche/droite
    gyro.alpha = a; gyro.beta = b; gyro.gamma = g;
  }

  if (typeof DeviceOrientationEvent !== 'undefined' &&
      typeof DeviceOrientationEvent.requestPermission === 'function') {
    // iOS 13+ — demande la permission
    DeviceOrientationEvent.requestPermission().then(state => {
      if (state === 'granted') window.addEventListener('deviceorientation', onOrientation, true);
    }).catch(() => {});
  } else {
    window.addEventListener('deviceorientation', onOrientation, true);
  }
}

function stopGyro() {
  // on laisse l'event actif (pas de removeEventListener global) — il est léger
  gyroBaseAlpha = null;
}

/* ============================================================
   PHOTO 360° DU SALON — image équirectangulaire embarquée (base64)
   Utilisée uniquement pour le fond du launcher (a-sky)
============================================================ */
const LIVING_ROOM_360_B64 = "";

/* ============================================================
   MOTEUR 360° EN CANVAS — projection sphérique réutilisable
   (même principe que le shooter : yaw/pitch → coordonnées écran)
============================================================ */
function project360(targetYaw, targetPitch, cameraYaw, cameraPitch, ox, W, H, fovH, fovV) {
  let dYaw = targetYaw - cameraYaw;
  if (dYaw > 180) dYaw -= 360;
  if (dYaw < -180) dYaw += 360;
  const dPitch = targetPitch - cameraPitch;
  if (Math.abs(dYaw) > fovH/2 + 25 || Math.abs(dPitch) > fovV/2 + 25) return null;
  const sx = ox + W/2 + (dYaw / (fovH/2)) * (W/2);
  const sy = H/2  - (dPitch / (fovV/2)) * (H/2);
  return { x: sx, y: sy, dYaw, dPitch };
}

// Génère un champ d'étoiles fixe (positions angulaires stables, calculées une fois)
function makeStarfield(count, seedMul) {
  const stars = [];
  for (let i = 0; i < count; i++) {
    stars.push({
      yaw: (i * seedMul) % 360,
      pitch: ((i * 53.7 + i*i*0.013) % 170) - 85,
      size: 0.8 + (i % 5) * 0.35,
      tw: i % 7
    });
  }
  return stars;
}
const bgStars = makeStarfield(220, 137.508);

function drawNebulaBackground(c, ox, W, H, camYaw, camPitch, fovH, fovV, tint1, tint2) {
  // dégradé de fond façon nébuleuse, qui glisse légèrement avec le yaw (parallax léger)
  const parallax = (camYaw / 360) * W * 0.15;
  const grad = c.createRadialGradient(
    ox + W/2 - parallax, H*0.4, 20,
    ox + W/2 - parallax, H*0.4, W*0.9
  );
  grad.addColorStop(0, tint1);
  grad.addColorStop(0.55, '#0a0a2e');
  grad.addColorStop(1, '#020208');
  c.fillStyle = grad;
  c.fillRect(ox, 0, W, H);

  // seconde nébuleuse décalée
  const grad2 = c.createRadialGradient(
    ox + W*0.75 - parallax*0.6, H*0.75, 10,
    ox + W*0.75 - parallax*0.6, H*0.75, W*0.6
  );
  grad2.addColorStop(0, tint2);
  grad2.addColorStop(1, 'rgba(0,0,0,0)');
  c.fillStyle = grad2;
  c.fillRect(ox, 0, W, H);

  // étoiles projetées selon l'orientation de la tête
  const t = Date.now() * 0.002;
  bgStars.forEach(s => {
    const p = project360(s.yaw, s.pitch, camYaw, camPitch, ox, W, H, fovH, fovV);
    if (!p) return;
    const twinkle = 0.55 + 0.45 * Math.sin(t + s.tw);
    c.fillStyle = `rgba(255,255,255,${twinkle})`;
    c.beginPath(); c.arc(p.x, p.y, s.size, 0, Math.PI*2); c.fill();
  });
}

/* ============================================================
   LAUNCHER — Vraie photo 360° du salon en fond (a-sky),
   menu de cartes ancré dans l'espace 3D
============================================================ */
const menuItems = [
  { ico: '🚀', label: 'Espace',   action: "startMode('space')" },
  { ico: '🌊', label: 'Océan',    action: "startMode('ocean')" },
  { ico: '🏙️', label: 'Ville',    action: "startMode('city')" },
  { ico: '🎯', label: 'Shooter',  action: "startMode('game-shooter')" },
  { ico: '⚡', label: 'Dodge',    action: "startMode('game-dodge')" },
  { ico: '🌐', label: 'Web',      action: "openBrowser()" }
];

function buildLauncherScene() {
  const cols = 3;
  const spacingX = 1.05, spacingY = 0.95;
  const startX = -((cols - 1) * spacingX) / 2;

  const cards = menuItems.map((item, i) => {
    const col = i % cols, row = Math.floor(i / cols);
    const x = startX + col * spacingX;
    const y = 0.5 - row * spacingY;
    return `
      <a-entity position="${x} ${y} -3.4" class="menu-card"
        onclick="${item.action}">
        <a-plane width="0.85" height="0.78" color="#0a0a18" opacity="0.62"
          material="shader: flat"
          animation__hover="property: components.material.material.opacity; startEvents: mouseenter; to: 0.88; dur: 180"
          animation__out="property: components.material.material.opacity; startEvents: mouseleave; to: 0.62; dur: 250">
        </a-plane>
        <a-plane width="0.89" height="0.82" color="#7f5af0" opacity="0"
          material="shader: flat"
          animation__border="property: components.material.material.opacity; startEvents: mouseenter; to: 0.35; dur: 180"
          animation__borderout="property: components.material.material.opacity; startEvents: mouseleave; to: 0; dur: 250"
          position="0 0 -0.005"></a-plane>
        <a-text value="${item.ico}" align="center" width="3.6" position="0 0.18 0.01"></a-text>
        <a-text value="${item.label}" align="center" color="#ffffff" width="2.4"
          position="0 -0.22 0.01"></a-text>
      </a-entity>`;
  }).join('');

  document.getElementById('launcher-scene').innerHTML = `
    <a-scene vr-mode-ui="enabled: true" embedded style="width:100%;height:100%;display:block" background="color:#05050f">
      <!-- Photo panoramique réelle du salon, projetée à 360° -->
      <a-sky src="data:image/jpeg;base64,${LIVING_ROOM_360_B64}" rotation="0 -90 0"></a-sky>

      <a-light type="ambient" color="#ffffff" intensity="0.85"></a-light>

      <!-- Titre flottant ancré dans la scène -->
      <a-entity position="0 1.55 -3.4">
        <a-plane color="#000" opacity="0.45" width="3" height="0.5" material="shader:flat"></a-plane>
        <a-text value="🥽 VR CARDBOARD HUB" align="center" color="#ffffff" width="3" position="0 0.1 0.01"></a-text>
        <a-text value="Regarde une carte pour la sélectionner" align="center" color="#bcd2ff" width="2.2" position="0 -0.13 0.01"></a-text>
      </a-entity>

      <!-- Menu ancré dans la scène (cartes 3D devant le canapé) -->
      <a-entity id="menu-root">
        ${cards}
      </a-entity>

      <a-entity position="0 -1.3 -3.4">
        <a-plane color="#000" opacity="0.4" width="2.8" height="0.32" material="shader:flat"></a-plane>
        <a-text value="👁 Tourne la tête pour explorer le salon à 360°" align="center"
          color="#2cb67d" width="2.5" position="0 0 0.01"></a-text>
      </a-entity>

      <a-camera look-controls="enabled: true; reverseMouseDrag: false" wasd-controls="enabled: false" position="0 0 0">
        <a-cursor color="#7f5af0" fuse="true" fuse-timeout="1400"
          animation__fusing="property:scale;startEvents:fusing;easing:easeInCubic;dur:1400;from:1 1 1;to:0.1 0.1 0.1"
          animation__mouseleave="property:scale;startEvents:mouseleave;easing:easeInCubic;dur:400;to:1 1 1"
          raycaster="objects: .menu-card, .menu-card *">
        </a-cursor>
      </a-camera>
    </a-scene>
  `;

  const loading = document.getElementById('launcher-loading');
  const sceneEl = document.querySelector('#launcher-scene a-scene');
  if (loading) loading.classList.remove('hidden');
  if (sceneEl) {
    const dismiss = () => loading && loading.classList.add('hidden');
    sceneEl.addEventListener('loaded', dismiss);
    sceneEl.addEventListener('renderstart', dismiss);
    setTimeout(dismiss, 1500);
  }
}

// Utilitaire de dessin rectangle arrondi, utilisé par les scènes immersives Canvas
function roundRectPath(c, x, y, w, h, r) {
  c.beginPath();
  c.moveTo(x+r, y);
  c.arcTo(x+w, y,   x+w, y+h, r);
  c.arcTo(x+w, y+h, x,   y+h, r);
  c.arcTo(x,   y+h, x,   y,   r);
  c.arcTo(x,   y,   x+w, y,   r);
  c.closePath();
}

/* ============================================================
   SCENES IMMERSIVES (Espace / Océan / Ville) — même moteur Canvas
============================================================ */
const scenes = {
  space: {
    label: '🚀 ESPACE', sub: 'Regarde autour de toi !',
    tint1: '#241a55', tint2: '#0d2a55', ground: '#000011',
    deco: [
      { type:'sphere', yaw: -28, pitch: 14, r: 0.5, color: '#7f5af0' },
      { type:'box',    yaw:  30, pitch: 6,  r: 0.4, color: '#2cb67d' },
      { type:'ring',   yaw:   2, pitch: -8, r: 0.7, color: '#ff8906' }
    ]
  },
  ocean: {
    label: '🌊 OCÉAN', sub: 'Exploration immersive',
    tint1: '#0a3a55', tint2: '#0a5a4a', ground: '#001133',
    deco: [
      { type:'sphere', yaw: -22, pitch: 10, r: 0.55, color: '#2cb6c8' },
      { type:'box',    yaw:  26, pitch: 4,  r: 0.4,  color: '#1a8a6a' },
      { type:'ring',   yaw:   4, pitch: -10,r: 0.65, color: '#5ad1c9' }
    ]
  },
  city: {
    label: '🏙️ VILLE', sub: 'Metropolis VR',
    tint1: '#3a2a4a', tint2: '#2a1a3a', ground: '#111122',
    deco: [
      { type:'sphere', yaw: -25, pitch: 12, r: 0.45, color: '#ff8906' },
      { type:'box',    yaw:  28, pitch: 5,  r: 0.5,  color: '#7f5af0' },
      { type:'ring',   yaw:   0, pitch: -9, r: 0.6,  color: '#e53e3e' }
    ]
  }
};

let gameLoop = null;
let sceneLoop = null;

function startMode(mode) {
  startGyro();
  if (mode.startsWith('game-')) { startGame(mode.replace('game-','')); return; }
  buildVRScene(scenes[mode]);
}

function buildVRScene(s) {
  hide('launcher'); show('vr-container'); showBack();
  document.getElementById('vr-container').innerHTML = '<canvas id="vr-canvas"></canvas>';
  const canvas = document.getElementById('vr-canvas');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  runImmersiveScene(canvas, s);
}

function runImmersiveScene(canvas, s) {
  if (sceneLoop) cancelAnimationFrame(sceneLoop);
  const ctx = canvas.getContext('2d');
  const FOV_H = 80, FOV_V = 62;
  const t0 = Date.now();

  function draw() {
    const FW = canvas.width, FH = canvas.height;
    const camYaw   = gyro.active ? gyro.yaw : 0;
    const camPitch = gyro.active ? -gyro.pitch * 0.5 : 0;
    const age = (Date.now() - t0) / 1000;

    drawStereo(ctx, FW, FH, (c, ox, W, H) => {
      drawNebulaBackground(c, ox, W, H, camYaw, camPitch, FOV_H, FOV_V, s.tint1, s.tint2);

      // sol/horizon teinté
      const groundPos = project360(0, -45, camYaw, camPitch, ox, W, H, FOV_H, FOV_V);
      if (groundPos) {
        const g = c.createLinearGradient(ox, H*0.65, ox, H);
        g.addColorStop(0, 'rgba(0,0,0,0)');
        g.addColorStop(1, s.ground);
        c.fillStyle = g; c.fillRect(ox, H*0.55, W, H*0.45);
      }

      // objets décoratifs en orbite lente
      s.deco.forEach((d, i) => {
        const orbitYaw = d.yaw + Math.sin(age * 0.15 + i) * 4;
        const orbitPitch = d.pitch + Math.cos(age * 0.1 + i) * 2;
        const p = project360(orbitYaw, orbitPitch, camYaw, camPitch, ox, W, H, FOV_H, FOV_V);
        if (!p) return;
        const size = W * d.r * 0.16;
        c.save();
        c.translate(p.x, p.y);
        c.rotate(age * (0.2 + i*0.05));
        c.fillStyle = d.color;
        if (d.type === 'sphere') {
          const grad = c.createRadialGradient(-size*0.3,-size*0.3,size*0.1, 0,0,size);
          grad.addColorStop(0, '#fff'); grad.addColorStop(0.25, d.color); grad.addColorStop(1, '#000');
          c.fillStyle = grad;
          c.beginPath(); c.arc(0,0,size,0,Math.PI*2); c.fill();
        } else if (d.type === 'box') {
          c.fillRect(-size*0.7, -size*0.7, size*1.4, size*1.4);
        } else if (d.type === 'ring') {
          c.strokeStyle = d.color; c.lineWidth = size*0.22;
          c.beginPath(); c.ellipse(0,0,size,size*0.4,0,0,Math.PI*2); c.stroke();
        }
        c.restore();
      });

      // panneau titre ancré devant
      const titlePos = project360(0, 20, camYaw, camPitch, ox, W, H, FOV_H, FOV_V);
      if (titlePos) {
        c.fillStyle = 'rgba(10,10,20,0.7)';
        roundRectPath(c, titlePos.x - W*0.24, titlePos.y - W*0.045, W*0.48, W*0.09, 8);
        c.fill();
        c.fillStyle = '#fff'; c.textAlign = 'center';
        c.font = `bold ${Math.floor(W*0.045)}px Segoe UI`;
        c.fillText(s.label, titlePos.x, titlePos.y + W*0.005);
        c.fillStyle = '#9aa8e0'; c.font = `${Math.floor(W*0.026)}px Segoe UI`;
        c.fillText(s.sub, titlePos.x, titlePos.y + W*0.035);
      }

      // hint stéréo
      const hintPos = project360(0, -16, camYaw, camPitch, ox, W, H, FOV_H, FOV_V);
      if (hintPos) {
        c.fillStyle = '#2cb67d'; c.textAlign = 'center';
        c.font = `${Math.floor(W*0.024)}px Segoe UI`;
        c.fillText('👁 Tourne la tête pour explorer à 360°', hintPos.x, hintPos.y);
      }

      const cx = ox + W/2, cy = H/2;
      c.strokeStyle = 'rgba(255,255,255,0.4)'; c.lineWidth = 1.5;
      c.beginPath(); c.arc(cx, cy, 5, 0, Math.PI*2); c.stroke();
    });

    sceneLoop = requestAnimationFrame(draw);
  }
  sceneLoop = requestAnimationFrame(draw);
}


